---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { authors, getAvatar } from '../utils/authors.ts';

// Zähle Posts pro Autor
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const authorPostCounts: Record<string, number> = {};

allPosts.forEach((post) => {
  const postAuthors = Array.isArray(post.data.author)
    ? post.data.author
    : [post.data.author];
  postAuthors.forEach((authorId) => {
    if (authorId) {
      authorPostCounts[authorId] = (authorPostCounts[authorId] || 0) + 1;
    }
  });
});

const authorsList = Object.values(authors);
---

<BaseLayout title="Autoren">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <h1
        class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-gray-100"
      >
        Unsere Autoren
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Lerne die Menschen kennen, die unsere Inhalte erstellen
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        authorsList.map((author) => (
          <div class="p-6 bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow">
            <a
              href={`/authors/${author.id}`}
              class="flex items-start gap-4 group"
            >
              {getAvatar(author.avatar) ? (
                <Image
                  src={getAvatar(author.avatar)!}
                  alt={author.name}
                  width={80}
                  height={80}
                  class="w-20 h-20 rounded-full object-cover"
                />
              ) : (
                <div class="w-20 h-20 rounded-full bg-primary-600 flex items-center justify-center text-white text-2xl font-bold">
                  {author.name.charAt(0).toUpperCase()}
                </div>
              )}
              <div class="flex-1">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400">
                  {author.name}
                </h2>
                {authorPostCounts[author.id] > 0 && (
                  <p class="text-sm text-gray-500 dark:text-gray-500 mb-3">
                    {authorPostCounts[author.id]}{' '}
                    {authorPostCounts[author.id] === 1 ? 'Artikel' : 'Artikel'}
                  </p>
                )}
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
