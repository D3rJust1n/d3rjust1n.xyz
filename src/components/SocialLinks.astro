---
import { siteConfig } from '../config';
import { Icon } from 'astro-icon/components';
import type { SocialLinks } from '../utils/social';

interface Props {
  social?: SocialLinks;
}

const { social = siteConfig.social } = Astro.props;
---

<div class="flex gap-4">
  {
    social.github && (
      <a
        href={social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="GitHub"
      >
        <Icon name="simple-icons:github" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.email && (
      <a
        href={`mailto:${social.email}`}
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Email"
      >
        <Icon name="simple-icons:protonmail" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.youtube && (
      <a
        href={social.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="YouTube"
      >
        <Icon name="simple-icons:youtube" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.anilist && (
      <a
        href={social.anilist}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="AniList"
      >
        <Icon name="simple-icons:anilist" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.codeberg && (
      <a
        href={social.codeberg}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Codeberg"
      >
        <Icon name="simple-icons:codeberg" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.mastodon && (
      <a
        href={social.mastodon}
        target="_blank"
        rel="noopener noreferrer me"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Mastodon"
      >
        <Icon name="simple-icons:mastodon" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.bsky && (
      <a
        href={social.bsky}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Bluesky"
      >
        <Icon name="simple-icons:bluesky" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.twitch && (
      <a
        href={social.twitch}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Twitch"
      >
        <Icon name="simple-icons:twitch" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.discord && (
      <a
        href={social.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Discord"
      >
        <Icon name="simple-icons:discord" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.instagram && (
      <a
        href={social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Instagram"
      >
        <Icon name="simple-icons:instagram" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.rss && (
      <a
        href="/rss.xml"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="RSS Feed"
      >
        <Icon name="simple-icons:rss" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.fluxer && (
      <a
        href={social.fluxer}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Fluxer"
      >
        <Icon name="simple-icons:fluxer" class="w-6 h-6" />
      </a>
    )
  }
  {
    social.website && (
      <a
        href={social.website}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        aria-label="Website"
      >
        <Icon name="lucide:globe" class="w-6 h-6" />
      </a>
    )
  }
</div>
